rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin(){return request.auth != null && request.auth.uid == 'REPLACE_ADMIN_UID';}
  function validRequest(){let d=request.resource.data;return d.keys().hasOnly(['nickname','title','artist','url','phone','consent','lookupCode','status','createdAt','updatedAt']) && d.keys().hasAll(['nickname','title','artist','url','phone','consent','lookupCode','status','createdAt','updatedAt']) && d.nickname is string && d.nickname.size()>0 && d.nickname.size()<=40 && d.title is string && d.title.size()>0 && d.title.size()<=120 && d.artist is string && d.artist.size()<=100 && d.url is string && d.url.size()<=500 && (d.url=='' || d.url.matches('https://(www\\.|m\\.)?youtube\\.com/.*') || d.url.matches('https://youtu\\.be/.*')) && d.phone is string && d.phone.size()<=11 && d.phone.matches('([0-9]{10,11})?') && d.consent is bool && (d.phone=='' || d.consent==true) && d.lookupCode is string && d.lookupCode.matches('[0-9a-f]{36}') && d.status=='접수' && d.createdAt==request.time && d.updatedAt==request.time;}
  match /requests/{id} {
   allow create: if validRequest();
   allow read: if admin() || (resource.data.lookupCode == 'NO_PUBLIC_READ');
   allow update,delete: if admin();
  }
 }
}
